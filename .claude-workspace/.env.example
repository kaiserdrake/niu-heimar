# niu-heimar workspace secrets. Copy this file to the gitignored secrets file next to it
# (same name without ".example"), fill in the values yourself, then chmod 600 it.
# Claude never reads that file: set these values yourself.

# niu-notify Discord webhooks, one per channel (Channel > Edit Channel > Integrations > Webhooks).
# Format: https://discord.com/api/webhooks/<id>/<token>. Unset = that route is off
# (needs-you falls back to the alerts webhook).
DISCORD_WEBHOOK_NEEDS_YOU=
DISCORD_WEBHOOK_ACTIVITY=
DISCORD_WEBHOOK_CI=
DISCORD_WEBHOOK_LLM=
DISCORD_WEBHOOK_LIMITS=
DISCORD_WEBHOOK_ALERTS=
