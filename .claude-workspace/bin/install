#!/usr/bin/env bash
# Install/refresh the niu-heimar workspace: render templates, merge user settings,
# add bin/ to PATH, and re-link existing projects. Safe to run repeatedly.
# Usage: install [--no-user-settings] [--no-shell] [--web] [--notify]
set -euo pipefail

WS="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd -P)"
SHARED="$WS/.claude-workspace"
user_settings=true shell=true web=false notify=false
for a in "$@"; do
  case "$a" in
    --no-user-settings) user_settings=false ;;
    --no-shell) shell=false ;;
    --web) web=true ;;
    --notify) notify=true ;;
    *) echo "unknown option $a" >&2; exit 1 ;;
  esac
done
command -v jq >/dev/null || { echo "install: jq is required" >&2; exit 1; }

render() { sed "s|\${WORKSPACE}|$WS|g" "$1"; }

domains=()
for t in "$WS"/*/.claude/settings.domain.template.json; do
  [[ -e "$t" ]] || continue
  d="$(basename "$(dirname "$(dirname "$t")")")"; domains+=("$d")
  D="$WS/$d/.claude"
  render "$t" | jq . >"$D/settings.domain.json.tmp" && mv "$D/settings.domain.json.tmp" "$D/settings.domain.json"
  mkdir -p "$D/memory" "$D/agents"
  # MCP: committed template (niu-local etc.) merged over locally added servers in the gitignored mcp.json
  [[ -f "$D/mcp.json" ]] || echo '{ "mcpServers": {} }' >"$D/mcp.json"
  if [[ -f "$D/mcp.template.json" ]]; then
    render "$D/mcp.template.json" | jq -s '.[0] as $local | .[1] as $tpl | {mcpServers: (($local.mcpServers // {}) + ($tpl.mcpServers // {}))}' "$D/mcp.json" - >"$D/mcp.json.tmp" \
      && mv "$D/mcp.json.tmp" "$D/mcp.json"
  fi
  [[ -f "$D/LEARNINGS.md" ]] || printf '# %s learnings\n\n<!-- Short dated bullets: conventions, pitfalls, deploy quirks. No secrets. -->\n' "$d" >"$D/LEARNINGS.md"
  echo "rendered $d/.claude/settings.domain.json"
done
# WORK-only, gitignored company context
if [[ -d "$WS/WORK/.claude" && ! -f "$WS/WORK/.claude/COMPANY.local.md" ]]; then
  printf '# Company context (local only, never committed)\n\n<!-- GitLab host, group, infra names, internal conventions. -->\n' >"$WS/WORK/.claude/COMPANY.local.md"
fi

chmod +x "$SHARED"/bin/* "$SHARED"/hooks/*.sh "$SHARED"/hooks/*.py "$SHARED"/tests/*.sh 2>/dev/null || true

# Workspace root sessions get niu-local too (gitignored, machine-specific path)
[[ -f "$WS/.mcp.json" ]] || echo '{ "mcpServers": {} }' >"$WS/.mcp.json"
jq --arg cmd "$SHARED/bin/niu-local-mcp" '.mcpServers["niu-local"] = {type: "stdio", command: $cmd, args: []}' "$WS/.mcp.json" >"$WS/.mcp.json.tmp" \
  && mv "$WS/.mcp.json.tmp" "$WS/.mcp.json"
# Isolated Claude Code config for local Ollama agents (no Anthropic credentials, read-only tools, guard hooks)
python3 "$SHARED/bin/niu-agent" setup >/dev/null && echo "wrote isolated config for local Ollama agents"

if $user_settings; then
  US="$HOME/.claude/settings.json"; mkdir -p "$HOME/.claude/backups"
  [[ -f "$US" ]] || echo '{}' >"$US"
  cp "$US" "$HOME/.claude/backups/settings.json.$(date +%Y%m%d-%H%M%S)"
  frag="$(render "$SHARED/user-settings.template.json")"
  # Drop earlier niu-heimar entries (anything mentioning $WS), then append fresh ones.
  jq --arg ws "$WS" --argjson frag "$frag" '
    def mine: tostring | contains($ws);
    .permissions.deny = ([(.permissions.deny // [])[] | select(mine | not)] + ($frag.permissions.deny // []))
    | .hooks = (.hooks // {})
    | .hooks |= with_entries(.value |= [ .[] | .hooks |= [ .[] | select(mine | not) ] | select(.hooks | length > 0) ])
    | reduce ($frag.hooks // {} | to_entries[]) as $e (.; .hooks[$e.key] = ((.hooks[$e.key] // []) + $e.value))
    | .hooks |= with_entries(select(.value | length > 0))
  ' "$US" >"$US.tmp" && mv "$US.tmp" "$US"
  echo "merged niu-heimar rules into $US (backup in ~/.claude/backups/)"
  # Status line: records Claude plan limits for the dashboard. Never replaces a status line you set yourself.
  sl="$(render "$SHARED/statusline.template.json")"
  if jq -e --arg ws "$WS" '(.statusLine == null) or ((.statusLine.command // "") | contains($ws))' "$US" >/dev/null; then
    jq --argjson sl "$sl" '.statusLine = $sl.statusLine' "$US" >"$US.tmp" && mv "$US.tmp" "$US"
    echo "status line set to niu-statusline (shows and records Claude 5-hour / weekly limits)"
  else
    echo "note: you have your own statusLine; leaving it. To feed Claude limits to the dashboard, pipe its input to $SHARED/bin/niu-statusline"
  fi
fi

if $shell; then
  # zsh: ~/.zshenv (keeps tools like zoxide last in ~/.zshrc); bash: ~/.bashrc if present
  rcs=()
  command -v zsh >/dev/null && rcs+=("$HOME/.zshenv")
  [[ -f "$HOME/.bashrc" ]] && rcs+=("$HOME/.bashrc")
  for rc in "${rcs[@]}"; do
    touch "$rc"
    if grep -q '# >>> niu-heimar >>>' "$rc"; then
      sed -i '/# >>> niu-heimar >>>/,/# <<< niu-heimar <<</d' "$rc"
      sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$rc"
    fi
      cat >>"$rc" <<RC

# >>> niu-heimar >>>
export PATH="$SHARED/bin:\$PATH"
# cdc: link the current project (if needed), then start Claude Code
cdc() { claude-init -q && claude "\$@"; }
# cdash: agent dashboard (opens in a tmux split when inside tmux)
cdash() { if [ -n "\$TMUX" ]; then tmux split-window -h -l 45% agents-dash "\$@"; else agents-dash "\$@"; fi; }
# <<< niu-heimar <<<
RC
      echo "updated niu-heimar block in $rc (open a new shell)"
  done
fi

# Re-link projects that are already set up (at any depth), and git repos directly inside a domain.
for d in "${domains[@]}"; do
  {
    find "$WS/$d" -mindepth 3 -maxdepth 6 -path '*/.claude/settings.local.json' -type l -not -path '*/node_modules/*' 2>/dev/null \
      | sed 's|/.claude/settings.local.json$||'
    for p in "$WS/$d"/*/; do if [[ -d "$p/.git" ]]; then echo "${p%/}"; fi; done
  } | sort -u | while IFS= read -r p; do
    "$SHARED/bin/claude-init" -q "$p" || true
  done
done
if $web; then
  unit="$HOME/.config/systemd/user/niu-dash.service"
  mkdir -p "$(dirname "$unit")"
  cat >"$unit" <<UNIT
[Unit]
Description=niu-heimar web dashboard (127.0.0.1:8765)
After=network.target

[Service]
ExecStart=$SHARED/bin/niu-dash serve --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable --now niu-dash.service
  systemctl --user restart niu-dash.service
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
    loginctl enable-linger "$USER" 2>/dev/null && echo "enabled linger: niu-dash keeps running after logout and starts at boot" \
      || echo "note: run 'sudo loginctl enable-linger $USER' so niu-dash runs without an active login"
  fi
  echo "niu-dash running: http://127.0.0.1:8765  (systemctl --user status niu-dash)"
  cat <<'TS'
To reach it from your other tailnet devices (one-time, run these yourself):
  sudo tailscale set --operator=$USER
  tailscale serve --bg --https=8443 http://127.0.0.1:8765
  tailscale serve status
Then pair each browser: run `niu-dash pair` here and enter the code on that device.
TS
fi
if $notify; then
  # Discord notifier (outbound webhooks only). Webhook URLs live in $SHARED/.env, which only systemd reads.
  unit="$HOME/.config/systemd/user/niu-notify.service"
  mkdir -p "$(dirname "$unit")"
  python3 "$SHARED/bin/niu-notify" unit >"$unit.tmp" && mv "$unit.tmp" "$unit"
  [[ -f "$SHARED/discord.json" ]] || { cp "$SHARED/discord.template.json" "$SHARED/discord.json"; echo "created $SHARED/discord.json (edit endpoints for your ollama.json names)"; }
  secrets="$SHARED/.env"
  if [[ -e "$secrets" ]]; then
    mode="$(stat -c %a "$secrets")"
    [[ "$mode" =~ [0-7]00$ ]] || echo "warning: $secrets is readable by others (mode $mode); run: chmod 600 $secrets"
  else
    echo "note: create $secrets with the DISCORD_WEBHOOK_* names from .env.example (you set the values), then chmod 600 it"
  fi
  systemctl --user daemon-reload
  systemctl --user enable niu-notify.service
  systemctl --user restart niu-notify.service
  if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null)" != "yes" ]]; then
    loginctl enable-linger "$USER" 2>/dev/null && echo "enabled linger: niu-notify keeps running after logout and starts at boot" \
      || echo "note: run 'sudo loginctl enable-linger $USER' so niu-notify runs without an active login"
  fi
  echo "niu-notify running (systemctl --user status niu-notify; journalctl --user -u niu-notify)"
  echo "check the webhooks with: niu-notify check   (Discord setup steps: README, 'Discord notifications')"
fi
echo "niu-heimar installed at $WS"
